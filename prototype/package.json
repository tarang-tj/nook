{
  "name": "nook-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Nook prototype, a draft sample: measure a distance, a room outline and a simple fit on a floor from one photo, with a sheet of paper as the known size.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --config vite.https.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --base=./",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

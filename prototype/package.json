{
  "name": "nook-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Nook prototype: measure a floor distance from one photo, with a sheet of paper as the known size.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --base=./",
    "preview": "vite preview --host"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

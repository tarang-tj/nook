{
  "name": "nook-site",
  "version": "0.1.0",
  "private": true,
  "description": "Nook landing page: an animated early-interest site for students, with signups sent to a Google Form.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "check": "tsc --noEmit",
